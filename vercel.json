{
  "version": 2,
  "name": "taskmaster",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "settings.html",
      "use": "@vercel/static"
    },
    {
      "src": "privacy.html",
      "use": "@vercel/static"
    },
    {
      "src": "terms.html",
      "use": "@vercel/static"
    },
    {
      "src": "offline.html",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "browserconfig.xml",
      "use": "@vercel/static"
    },
    {
      "src": "icons/*",
      "use": "@vercel/static"
    },
    {
      "src": "mood.html",
      "use": "@vercel/static"
    },
    {
      "src": "TaskMaster-qrcode.png",
      "use": "@vercel/static"
    },
    {
      "src": "IMG_0124.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "IMG_0125.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/settings",
      "dest": "/settings.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/offline",
      "dest": "/offline.html"
    },
    {
      "src": "/mood",
      "dest": "/mood.html"
    },
    {
      "src": "/TaskMaster-qrcode.png",
      "dest": "/TaskMaster-qrcode.png"
    },
    {
      "src": "/IMG_0124.jpg",
      "dest": "/IMG_0124.jpg"
    },
    {
      "src": "/IMG_0125.jpg",
      "dest": "/IMG_0125.jpg"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/browserconfig.xml",
      "dest": "/browserconfig.xml"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/browserconfig.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
